# acp-bridge configuration
# All values can be overridden by environment variables.
# When spawned by openab, env vars are sufficient — this file is optional.

[llm]
# OpenAI-compatible endpoint
base_url = "http://localhost:11434/v1"

# Model name
model = "gemma4:26b"

# API key (most local services ignore this)
# api_key = "local-ai"

# Custom system prompt (auto-generated if not set)
# system_prompt = "You are a helpful coding assistant."

# Sampling temperature (0.0 - 2.0)
# temperature = 0.7

# Maximum tokens to generate
# max_tokens = 4096

# HTTP timeout in seconds
timeout_secs = 300   # idle timeout: fail after this long with no data from the backend (0 = none)

# Max conversation turns to keep (0 = unlimited). A turn = one user prompt
# plus its tool calls/results and answer. History is also trimmed to 75%
# of model_context.
max_history_turns = 50

# Model context window in tokens (drives the history budget)
# model_context = 32768

# Stream agent responses live (set false if your backend can't stream with tools)
# stream = true

# Max tool-call rounds per prompt turn (default 100, 0 = unlimited)
# max_tool_rounds = 100

# Timeout in seconds for one bash tool call (default 120, 0 = none).
# The command's whole process group is killed on timeout or cancel.
# bash_timeout_secs = 120

# ---------------------------------------------------------------------------
# MCP relay — tools from the Client's mcpServers (e.g. Xcode's xcrun mcpbridge)
# Env vars LLM_MCP, LLM_XCODE_TOOLS, LLM_MCP_TOOLS, LLM_MCP_EXCLUDE_TOOLS and
# LLM_MCP_TOOL_TIMEOUT take precedence.
# ---------------------------------------------------------------------------
# [mcp]
# enabled = true              # relay stdio mcpServers from session/new
# xcode_tools = "auto"        # auto | on | off — add xcrun mcpbridge if missing
# tools = ["Build*", "Run*Tests", "GetBuildLog", "XcodeRefreshCodeIssuesInFile"]
# exclude_tools = ["GetTop*", "DeviceInteraction*"]
# tool_timeout_secs = 600     # per MCP tool call, 0 = none
# connect_timeout_secs = 120  # MCP handshake (Xcode can take 15-40 s), 0 = none

# ---------------------------------------------------------------------------
# Client mode — spawn an external ACP agent (used with --client flag)
# ---------------------------------------------------------------------------
# [agent]
# command = "opencode"
# args = ["acp"]
# working_dir = "/home/node"
#
# # Optional environment variables passed to the agent process
# [agent.env]
# OPENAI_API_KEY = "${OPENAI_API_KEY}"
