# acp-bridge configuration
# All values can be overridden by environment variables.
# When spawned by openab, env vars are sufficient — this file is optional.

[llm]
# OpenAI-compatible endpoint
base_url = "http://localhost:11434/v1"

# Model name
model = "gemma4:26b"

# API key (most local services ignore this)
# api_key = "local-ai"

# Custom system prompt (auto-generated if not set)
# system_prompt = "You are a helpful coding assistant."

# Sampling temperature (0.0 - 2.0)
# temperature = 0.7

# Maximum tokens to generate
# max_tokens = 4096

# HTTP timeout in seconds
timeout_secs = 300

# User-turn count that requests a summary (0 disables only the count trigger)
max_history_turns = 50

# Semantic summaries use the same model without tools; budget checks remain active if off.
# Environment overrides: LLM_AUTO_SUMMARIZE and LLM_SUMMARIZE_AT
auto_summarize = true
summarize_at = 0.6

# Inline budget per tool result; larger outputs become re-readable
# artifact files under the session dir (env LLM_ARTIFACT_CHARS).
# artifact_inline_chars = 8192

# Total inline budget for ALL tool results within one prompt turn;
# once spent, later results degrade to pointer-only regardless of the
# per-item cap (env LLM_TURN_TOOL_CHARS).
# turn_tool_chars = 16384

# Maximum model↔tool round-trips in one prompt turn before the bounded
# wrap-up path runs (env LLM_MAX_TOOL_ROUNDS, default 50)
# max_tool_rounds = 50

# Per-tool wall-clock timeout in seconds; bash/git/web_fetch processes
# exceeding it are killed with their process group (env LLM_TOOL_TIMEOUT)
# tool_timeout_secs = 120

# Whole-turn deadline in seconds; 0 = no limit (env LLM_TURN_TIMEOUT)
# turn_timeout_secs = 0

# Abort the tool loop after this many consecutive identical tool failures
# (same tool, same args, error) — catches models stuck re-issuing a
# failing call (env LLM_TOOL_FAILURE_STREAK)
# tool_failure_streak = 3

# ── Tool policy (P1/E12) ──────────────────────────────────────────────
# Per-capability actions: allow | audit | confirm | deny.
#   allow   → run the tool
#   audit   → emit a visible "[policy:audit]" notice, then run
#             (a logged proceed — OpenAB has no interactive permission
#             channel, so nothing can be approved mid-turn)
#   confirm → run ONLY when the capability is granted via `grants`
#             below or LLM_POLICY_GRANTS; ungranted → denied. It never
#             executes unconfirmed.
#   deny    → return a structured error to the model, do not execute
# Env overrides: LLM_POLICY_READ / _WRITE / _SHELL / _WEB
#
# [policy]
# read = "allow"          # read_file, list_dir, search_code
# write = "allow"         # write_file, edit
# shell = "audit"         # bash, git_*
# web = "audit"           # web_fetch
#
# Deployment-scope capability grants for confirm actions (read |
# write | shell | web). Env: LLM_POLICY_GRANTS="shell,web"
# grants = ["shell"]
#
# Workspace-relative glob denies — applied to file tools' `path` AND
# to every path list_dir/search_code enumerate. `*` does not cross
# `/`, `**` does; a pattern with no `/` matches basenames at any depth.
# deny_path_globs = [".env", ".env.*", "*.pem", "*.key", ".ssh/**", ".aws/**", ".gnupg/**"]

# NOTE: unknown sections/fields are rejected at startup — a config written
# for a newer build must fail visibly instead of being silently ignored.
